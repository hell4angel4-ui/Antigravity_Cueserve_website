!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Next.js build output
/.next/
/out/

# production
/build
/dist

# local environment variables
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

